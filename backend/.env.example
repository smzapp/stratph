# Copy this file to .env and fill in real values. .env is gitignored.

PORT=3001
JWT_SECRET=stratph-dev-secret-change-me
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=stratph.sqlite

# Mailtrap sandbox SMTP — from your Mailtrap inbox's "SMTP Settings" tab
# (same idea as Laravel's MAIL_* env vars). Used for job alert emails and
# team invite emails. Left blank, emails are just logged instead of sent.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@stratph.app
MAIL_FROM_NAME=StratPH
